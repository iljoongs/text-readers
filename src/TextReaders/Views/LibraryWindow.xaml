<Window x:Class="TextReaders.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TextReaders.Views"
        Title="라이브러리" Height="480" Width="640">
    <Window.Resources>
        <local:BookCardColorConverter x:Key="BookCardColorConverter" />
        <local:CompletedToLabelConverter x:Key="CompletedToLabelConverter" />
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F0EEEA" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="총 독서 시간: " FontWeight="Bold" />
                <TextBlock Text="{Binding TotalReadingTimeText}" Margin="0,0,20,0" />
                <TextBlock Text="완독: " FontWeight="Bold" />
                <TextBlock Text="{Binding CompletedBookCount, StringFormat={}{0}권}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding LibraryEntries}" Margin="12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="140" Height="190" Margin="8" Cursor="Hand"
                                Background="{Binding Title, Converter={StaticResource BookCardColorConverter}}"
                                CornerRadius="4"
                                MouseLeftButtonUp="LibraryEntryCard_MouseLeftButtonUp">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" />
                            </Border.Effect>
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="14"
                                           TextWrapping="Wrap" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding IsCompleted, Converter={StaticResource CompletedToLabelConverter}}"
                                           FontSize="11" FontWeight="Bold" />
                                <TextBlock Grid.Row="2" Text="{Binding LastPageIndex, StringFormat={}{0}페이지 · }" FontSize="11" Opacity="0.75" />
                                <TextBlock Grid.Row="3" Text="{Binding ReadingTimeDisplay}" FontSize="11" Opacity="0.75" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
