<Window x:Class="TextReaders.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TextReaders.Views"
        Title="라이브러리" Height="480" Width="640"
        AllowDrop="True" DragOver="LibraryWindow_DragOver" Drop="LibraryWindow_Drop">
    <Window.Resources>
        <local:BookCardColorConverter x:Key="BookCardColorConverter" />
        <local:CompletedToLabelConverter x:Key="CompletedToLabelConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <!-- 파일(txt/md/mybook)을 이 창 전체 어디에 드롭해도 라이브러리에 추가된다(Window.Drop). -->
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일">
                <MenuItem Header="열기" Command="{Binding OpenMyBookCommand}" />
                <MenuItem Header="저장" Command="{Binding SaveAsMyBookCommand}" />
                <MenuItem Header="다른 이름으로 저장" Click="SaveMyBookAsMenuItem_Click" />
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="#F0EEEA" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="총 독서 시간: " FontWeight="Bold" />
                <TextBlock Text="{Binding TotalReadingTimeText}" Margin="0,0,20,0" />
                <TextBlock Text="완독: " FontWeight="Bold" />
                <TextBlock Text="{Binding CompletedBookCount, StringFormat={}{0}권}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- 한 번 클릭은 선택만, 더블클릭으로 열기(카드 코드비하인드에서 ClickCount로 구분). -->
            <ListBox x:Name="EntryListBox" ItemsSource="{Binding LibraryEntries}"
                     SelectedItem="{Binding SelectedLibraryEntry}"
                     SelectionMode="Single"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="12">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="SelectionBorder" Margin="6" Padding="2" CornerRadius="6"
                                            BorderThickness="2" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#4A90D9" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="140" Height="190" Cursor="Hand"
                                Background="{Binding Title, Converter={StaticResource BookCardColorConverter}}"
                                CornerRadius="4"
                                MouseLeftButtonDown="LibraryEntryCard_MouseLeftButtonDown"
                                PreviewMouseRightButtonDown="LibraryEntryCard_PreviewMouseRightButtonDown">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" />
                            </Border.Effect>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="mybook으로 저장" Click="SaveAsMyBookMenuItem_Click" />
                                    <MenuItem Header="mybook으로 변경" Click="ConvertToMyBookMenuItem_Click" />
                                    <MenuItem Header="mybook 정보" Click="ShowMyBookInfoMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="삭제" Click="RemoveLibraryEntryMenuItem_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- mybook은 "기본" 형식이라 별도 표시가 없고, txt/md/json처럼 다른 형식만 배지로 구분한다. -->
                                <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#B0000000" CornerRadius="3" Padding="4,1"
                                        Visibility="{Binding IsTextFormat, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding FormatBadge}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                </Border>

                                <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="14"
                                           TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,16,0,0" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding IsCompleted, Converter={StaticResource CompletedToLabelConverter}}"
                                           FontSize="11" FontWeight="Bold" />
                                <TextBlock Grid.Row="2" Text="{Binding LastPageIndex, StringFormat={}{0}페이지 · }" FontSize="11" Opacity="0.75" />
                                <TextBlock Grid.Row="3" Text="{Binding ReadingTimeDisplay}" FontSize="11" Opacity="0.75" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </DockPanel>
</Window>
