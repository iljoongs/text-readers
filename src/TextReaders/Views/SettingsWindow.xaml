<Window x:Class="TextReaders.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="320" Height="552" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="글꼴" FontWeight="Bold" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="+" ToolTip="폰트 추가" Command="{Binding AddCustomFontCommand}" Padding="8,2" Margin="6,0,0,0" />
            <ComboBox ItemsSource="{Binding AvailableFontFamilyNames}" SelectedItem="{Binding FontFamilyName}" />
        </DockPanel>

        <TextBlock Text="크기" FontWeight="Bold" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Right" Text="{Binding FontSize, StringFormat={}{0:0}pt}" Width="40" VerticalAlignment="Center" />
            <Slider Minimum="12" Maximum="32" Value="{Binding FontSize}" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Text="줄간격" FontWeight="Bold" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Right" Text="{Binding LineSpacingMultiplier, StringFormat={}{0:0.0}x}" Width="40" VerticalAlignment="Center" />
            <Slider Minimum="1.0" Maximum="2.0" Value="{Binding LineSpacingMultiplier}" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Text="여백" FontWeight="Bold" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding MarginPresetOptions}" SelectedItem="{Binding MarginPreset}" HorizontalAlignment="Left" Width="120" Margin="0,0,0,16" />

        <TextBlock Text="테마" FontWeight="Bold" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" HorizontalAlignment="Left" Width="120" Margin="0,0,0,16" />

        <TextBlock Text="밝기" FontWeight="Bold" Margin="0,0,0,4" />
        <Slider Minimum="0" Maximum="0.7" Value="{Binding DimmingOpacity}" Margin="0,0,0,16" />

        <TextBlock Text="데이터 폴더" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBox Text="{Binding DataDirectoryPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,6" />
        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="기본" ToolTip="기본 위치로 되돌리기" Command="{Binding ResetDataDirectoryCommand}" Padding="8,2" Margin="6,0,0,0" />
            <Button Content="찾아보기..." Command="{Binding BrowseDataDirectoryCommand}" Padding="8,2" HorizontalAlignment="Left" />
        </DockPanel>
        <Button Content="기본 폴더 데이터 복사" ToolTip="기본 폴더의 데이터를 현재 데이터 폴더로 복사합니다" Command="{Binding CopyDefaultDataCommand}" Padding="8,2" HorizontalAlignment="Left" />
    </StackPanel>
</Window>
