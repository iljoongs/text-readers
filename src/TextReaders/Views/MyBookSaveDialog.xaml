<Window x:Class="TextReaders.Views.MyBookSaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mybook으로 저장" Height="210" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="제목:" Margin="0,0,0,4" />
        <TextBox x:Name="TitleTextBox" Margin="0,0,0,12" />
        <TextBlock Text="저자 (선택):" Margin="0,0,0,4" />
        <TextBox x:Name="AuthorTextBox" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="저장" Width="70" Click="OkButton_Click" IsDefault="True" Margin="0,0,8,0" />
            <Button Content="취소" Width="70" Click="CancelButton_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
