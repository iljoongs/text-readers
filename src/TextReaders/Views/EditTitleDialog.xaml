<Window x:Class="TextReaders.Views.EditTitleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="제목 편집" Height="150" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="새 제목 (실제 파일 이름이 바뀝니다):" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="TitleTextBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="확인" Width="70" Click="OkButton_Click" IsDefault="True" Margin="0,0,8,0" />
            <Button Content="취소" Width="70" Click="CancelButton_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
