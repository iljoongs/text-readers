<Window x:Class="TextReaders.Views.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="메모 추가" Height="200" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="하이라이트에 남길 메모 (선택 사항):" Margin="0,0,0,8" />
        <TextBox x:Name="NoteTextBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="확인" Width="70" Click="OkButton_Click" IsDefault="True" Margin="0,0,8,0" />
            <Button Content="취소" Width="70" Click="CancelButton_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
