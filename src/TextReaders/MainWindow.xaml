<Window x:Class="TextReaders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextReaders"
        xmlns:views="clr-namespace:TextReaders.Views"
        mc:Ignorable="d"
        Title="text-readers" Height="720" Width="1080">
    <Window.Resources>
        <views:PauseResumeLabelConverter x:Key="PauseResumeLabelConverter" />
    </Window.Resources>
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Menu>
                <MenuItem Header="☰">
                    <MenuItem Header="File">
                        <MenuItem Header="Open" Command="{Binding OpenFileCommand}" />
                        <MenuItem Header="Save" Command="{Binding SaveCommand}" />
                        <MenuItem Header="Save As" Command="{Binding SaveAsCommand}" />
                    </MenuItem>
                    <MenuItem Header="Settings" Click="SettingsMenuItem_Click" />
                </MenuItem>
            </Menu>
            <Separator />

            <Button Content="라이브러리" Click="LibraryButton_Click" Padding="8,2" />
            <Separator />

            <Button Content="북마크 추가" Command="{Binding AddBookmarkCommand}" Padding="8,2" />
            <ToggleButton x:Name="BookmarkListToggle" Content="북마크 목록 ▾" Padding="8,2" />
            <Popup PlacementTarget="{Binding ElementName=BookmarkListToggle}"
                   IsOpen="{Binding IsChecked, ElementName=BookmarkListToggle}"
                   StaysOpen="True" Placement="Bottom">
                <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="4" MinWidth="220" MaxHeight="300">
                    <ListBox ItemsSource="{Binding Bookmarks}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding PageNumber, StringFormat={}{0}페이지}" Width="90" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MM/dd HH:mm}}" Width="80" VerticalAlignment="Center" Foreground="Gray" />
                                    <Button Content="이동" Padding="4,0" Margin="4,0,0,0" Click="GoToBookmarkButton_Click" />
                                    <Button Content="삭제" Padding="4,0" Margin="4,0,0,0" Click="RemoveBookmarkButton_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <Separator />
            <ToggleButton x:Name="TocListToggle" Content="목차 ▾" Padding="8,2" />
            <Popup PlacementTarget="{Binding ElementName=TocListToggle}"
                   IsOpen="{Binding IsChecked, ElementName=TocListToggle}"
                   StaysOpen="True" Placement="Bottom">
                <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="4" MinWidth="220" MaxHeight="300">
                    <ListBox ItemsSource="{Binding TableOfContents}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding Title}" Width="180" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Content="이동" Padding="4,0" Margin="4,0,0,0" Click="GoToTocEntryButton_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <Separator />
            <TextBox Width="140" VerticalAlignment="Center" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding FindNextCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="찾기" Command="{Binding FindNextCommand}" Padding="8,2" />

            <Separator />
            <Button Content="하이라이트" Click="AddHighlightButton_Click" Padding="8,2" />

            <Separator />
            <Button Content="읽어주기" Click="PlayButton_Click" IsEnabled="{Binding CanStartReading}" Padding="8,2" />
            <Button Content="{Binding IsPaused, Converter={StaticResource PauseResumeLabelConverter}}"
                    Command="{Binding TogglePauseCommand}" IsEnabled="{Binding IsSpeaking}" Padding="8,2" />
            <Button Content="정지" Command="{Binding StopReadingCommand}" IsEnabled="{Binding IsSpeaking}" Padding="8,2" />

            <Separator />
            <TextBlock Text="{Binding CurrentBook.Title}" VerticalAlignment="Center" Margin="12,0" />
            <TextBlock Text="{Binding ReadingProgressText}" VerticalAlignment="Center" Margin="8,0" />
        </ToolBar>

        <Grid>
            <FlowDocumentPageViewer x:Name="PageViewer" Document="{Binding Document}"
                                     Background="{Binding PageBackgroundBrush}" />

            <Border Width="64" Margin="0,0,0,40" HorizontalAlignment="Left" Background="Transparent" Cursor="Hand"
                    MouseLeftButtonDown="PreviousPageZone_MouseLeftButtonDown" />
            <Border Width="64" Margin="0,0,0,40" HorizontalAlignment="Right" Background="Transparent" Cursor="Hand"
                    MouseLeftButtonDown="NextPageZone_MouseLeftButtonDown" />

            <Image x:Name="SnapshotOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" RenderTransformOrigin="0,0" />

            <Rectangle Fill="Black" IsHitTestVisible="False" Opacity="{Binding DimmingOpacity}" />
        </Grid>
    </DockPanel>
</Window>
