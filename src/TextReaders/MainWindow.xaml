<Window x:Class="TextReaders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextReaders"
        mc:Ignorable="d"
        Title="text-readers" Height="720" Width="1080">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="파일 열기" Command="{Binding OpenFileCommand}" Padding="8,2" />
            <Separator />

            <TextBlock Text="글꼴" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox Width="150" ItemsSource="{Binding AvailableFontFamilyNames}" SelectedItem="{Binding FontFamilyName}" />

            <Separator />
            <TextBlock Text="크기" VerticalAlignment="Center" Margin="4,0" />
            <Slider Width="90" Minimum="12" Maximum="32" Value="{Binding FontSize}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding FontSize, StringFormat={}{0:0}pt}" VerticalAlignment="Center" Width="34" />

            <Separator />
            <TextBlock Text="줄간격" VerticalAlignment="Center" Margin="4,0" />
            <Slider Width="90" Minimum="1.0" Maximum="2.0" Value="{Binding LineSpacingMultiplier}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LineSpacingMultiplier, StringFormat={}{0:0.0}x}" VerticalAlignment="Center" Width="34" />

            <Separator />
            <TextBlock Text="여백" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox Width="80" ItemsSource="{Binding MarginPresetOptions}" SelectedItem="{Binding MarginPreset}" />

            <Separator />
            <TextBlock Text="테마" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox Width="80" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" />

            <Separator />
            <TextBlock Text="밝기" VerticalAlignment="Center" Margin="4,0" />
            <Slider Width="90" Minimum="0" Maximum="0.7" Value="{Binding DimmingOpacity}" VerticalAlignment="Center" />

            <Separator />
            <TextBlock Text="{Binding CurrentBook.Title}" VerticalAlignment="Center" Margin="12,0" />
            <TextBlock Text="{Binding ReadingProgressText}" VerticalAlignment="Center" Margin="8,0" />
        </ToolBar>

        <Grid>
            <FlowDocumentPageViewer x:Name="PageViewer" Document="{Binding Document}"
                                     Background="{Binding PageBackgroundBrush}" />

            <Border Width="64" HorizontalAlignment="Left" Background="Transparent" Cursor="Hand"
                    MouseLeftButtonDown="PreviousPageZone_MouseLeftButtonDown" />
            <Border Width="64" HorizontalAlignment="Right" Background="Transparent" Cursor="Hand"
                    MouseLeftButtonDown="NextPageZone_MouseLeftButtonDown" />

            <Image x:Name="SnapshotOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" RenderTransformOrigin="0,0" />

            <Rectangle Fill="Black" IsHitTestVisible="False" Opacity="{Binding DimmingOpacity}" />
        </Grid>
    </DockPanel>
</Window>
