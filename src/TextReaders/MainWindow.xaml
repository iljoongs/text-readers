<Window x:Class="TextReaders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextReaders"
        mc:Ignorable="d"
        Title="text-readers" Height="720" Width="1080">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="파일 열기" Command="{Binding OpenFileCommand}" Padding="8,2" />
            <TextBlock Text="{Binding CurrentBook.Title}" VerticalAlignment="Center" Margin="12,0" />
        </ToolBar>

        <FlowDocumentPageViewer Document="{Binding Document}" />
    </DockPanel>
</Window>
